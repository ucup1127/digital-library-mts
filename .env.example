# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/muhapati"

# ============================================
# BACKUP & CRON
# ============================================
# Token untuk endpoint backup/restore
# Generate dengan: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
BACKUP_SECRET_TOKEN=""

# Token untuk endpoint cron job
# Generate dengan perintah yang sama seperti di atas
CRON_SECRET=""

# ============================================
# REDIS (opsional, untuk cache/session)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# NEXTAUTH
# ============================================
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# UPLOADTHING (upload file)
# ============================================
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""