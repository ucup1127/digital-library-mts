// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== MODEL DULUAN (YANG TIDAK DEPEND) ====================

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  website   String?   // ✅ Website resmi sekolah (untuk redirect)
  books     Book[]
  users     User[]
  profile   SchoolProfile? 
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi ke BookCategory
  books     BookCategory[]
  bukuFisik BukuFisikKategori[]
}

model User {
  id           String   @id @default(cuid())
  
  // 🔐 Login (dual mode)
  email        String?  @unique    // Admin: wajib, Siswa: NULL
  username     String?  @unique    // Admin & Siswa: wajib (login)
  nisn         String?  @unique    // Siswa: 10 digit, Admin: NULL
  password     String   @db.Text
  name         String?
  className    String?
  image        String?
  role         String   @default("USER")
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  
  memberId     String?  @unique    // Siswa = NISN, Admin = generate (MTS001)
  barcode      String?  @unique    // Siswa = NISN, Admin = memberId
  isActive     Boolean  @default(true)
  graduatedAt  DateTime?

  peminjamanFisik PeminjamanFisik[]
  sessions  Session[]
  notifications Notification[] 
  chatMessages  ChatMessage[]
  chatReadState ChatReadState? 
  activityLogs UserActivityLog[] 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([schoolId])
  @@index([role])
  @@index([barcode])
  @@index([username])
  @@index([nisn])
  @@index([isActive])
  @@index([schoolId, isActive])
  @@index([schoolId, role])
  @@index([schoolId, role, isActive])
}

model BukuFisik {
  id           String   @id @default(cuid())
  judul        String
  penulis      String
  penerbit     String?
  tahun        String?
  isbn         String?
  lokasiRak    String?
  stok         Int      @default(1)
  stokTersedia Int      @default(1)
  kondisi      String   @default("BAIK")
  barcode      String   @unique
  gambar       String?
  deskripsi    String?  @db.Text
  schoolId     String?  // ✅ Tambahkan: buku fisik per sekolah
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  peminjaman   PeminjamanFisik[]
  kategoriBuku BukuFisikKategori[]

  @@index([schoolId])
  @@index([barcode])
  @@index([schoolId, judul])
  @@index([schoolId, stokTersedia])
  @@index([schoolId, penulis])
  @@index([schoolId, isbn])
  @@index([schoolId, lokasiRak])
}

model PeminjamanFisik {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bukuFisikId   String
  bukuFisik     BukuFisik   @relation(fields: [bukuFisikId], references: [id], onDelete: Cascade)
  tglPinjam     DateTime    @default(now())
  tglKembali    DateTime
  tglDikembalikan DateTime?
  status        String      @default("DIPINJAM")
  denda         Int         @default(0)
  petugas       String?
  
  // 🔥 FIELD BARU — Perpanjangan
  extendedAt       DateTime?
  extendedCount    Int       @default(0)
  extensionStatus  String?   // "NONE" | "PENDING" | "APPROVED" | "REJECTED"
  extensionReason  String?   @db.Text
  extensionNote    String?   @db.Text
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([bukuFisikId])
  @@index([status])
  @@index([tglKembali])
  @@index([userId, status])
  @@index([bukuFisikId, status])
  @@index([status, tglKembali])
  @@index([tglPinjam])
  @@index([userId, tglPinjam])
  @@index([bukuFisikId, tglPinjam])
  @@index([extensionStatus])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   // "DUE_TODAY" | "OVERDUE" | "EXTEND_PENDING" | "EXTEND_APPROVED" | "EXTEND_REJECTED"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String   @db.Text
  createdAt  DateTime @default(now())
  
  @@index([createdAt])
  @@index([userId])
  @@index([createdAt, id])
}

model ChatReadState {
  id          String   @id @default(cuid())
  userId      String   @unique
  lastReadAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  position String
  imageUrl String?
  order    Int     @default(0)
}

model Visitor {
  id           String   @id @default(cuid())
  name         String
  schoolOrigin String
  accessedAt   DateTime @default(now())
  duration     Int      @default(0)
}

model SchoolProfile {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vision    String?  @db.Text
  mission   String?  @db.Text
  history   String?  @db.Text
  address   String?  @db.Text
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== MODEL DENGAN RELASI ====================

model Book {
  id            String    @id @default(cuid())
  title         String
  author        String
  description   String?   @db.Text
  coverUrl      String?
  fileUrl       String?
  year          String?
  isRecommended Boolean   @default(false)
  views         Int       @default(0)
  schoolId      String    // owner — sekolah yang upload
  uploadedBy    String?   // user ID admin yang upload
  isShared      Boolean   @default(true)  // true = bisa diakses semua sekolah
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categories    BookCategory[]

  @@index([title])
  @@index([author])
  @@index([schoolId])
  @@index([createdAt])
  @@index([views])
  @@index([title, author])
  @@index([schoolId, createdAt])
  @@index([schoolId, views])
  @@index([schoolId, isRecommended])
  @@index([schoolId, title])
  @@index([schoolId, author])
  @@index([schoolId, year])
  @@index([isShared])
  @@index([isShared, createdAt])
}

// Junction Table
model BookCategory {
  bookId     String
  categoryId String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([bookId])
  @@index([categoryId])
}

model VisitorLog {
  id         String   @id @default(cuid())
  userId     String?  
  userEmail  String?  
  action     String   
  bookId     String?  
  bookTitle  String?  
  categoryId String?
  schoolId   String?   // ✅ Tambahkan: log per sekolah
  ipAddress  String?
  userAgent  String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([sessionId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([schoolId, action])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([bookId])
  @@index([bookId, createdAt])
}

model ActiveSession {
  id         String   @id @default(cuid())
  userId     String
  userEmail  String
  userName   String
  sessionId  String   @unique
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  
  @@index([lastActive])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // ERROR, WARNING, INFO
  message   String   @db.Text
  stack     String?  @db.Text
  path      String?
  method    String?
  userId    String?
  userEmail String?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([level, createdAt])
  @@index([userEmail, createdAt])
}
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  adminName   String
  adminEmail  String
  adminRole   String
  schoolId    String?   // ✅ Bisa null untuk SUPER_ADMIN
  action      String
  targetType  String
  targetId    String?
  targetName  String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([schoolId])
  @@index([createdAt])
  @@index([action])
  @@index([schoolId, createdAt])
  @@index([adminId, createdAt])
  @@index([schoolId, action])
  @@index([adminRole, createdAt])
  @@index([targetType])
  @@index([schoolId, targetType])
  @@index([targetType, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  schoolId  String?
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([schoolId])
  @@index([schoolId, key])
}

model BukuFisikKategori {
  bukuFisikId String
  bukuFisik   BukuFisik @relation(fields: [bukuFisikId], references: [id], onDelete: Cascade)
  kategoriId  String
  kategori    Category  @relation(fields: [kategoriId], references: [id], onDelete: Cascade)

  @@id([bukuFisikId, kategoriId])
}

// ==================== MODEL BARU UNTUK GALERI ====================

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  category    String   @default("kegiatan") // kegiatan, koleksi, fasilitas, acara
  schoolId    String   // ✅ Wajib: galeri per sekolah
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([category])
  @@index([schoolId, createdAt])
  @@index([schoolId, category])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  csrfToken String   @unique @default(cuid()) 
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model UserActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String?
  action     String   // "LOGIN" | "LOGOUT" | "UPDATE_PROFILE" | "CHANGE_PASSWORD" | "EXTEND_LOAN"
  description String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([schoolId, createdAt])
}

